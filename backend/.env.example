# FinWise AI - Backend Environment Configuration

# Environment mode: development, staging, production
APP_ENV=development

# JWT Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL:
# For Local Development (Zero dependencies, SQLite):
DATABASE_URL=sqlite:///./finwise.db

# For Production with MySQL 8:
# DATABASE_URL=mysql+pymysql://finwise_user:finwise_secure_pass@db:3306/finwise_db

# Google Gemini API Key for Multi-Agent AI reasoning (Optional)
# If omitted or offline, the platform seamlessly uses deterministic rule-based calculators
GEMINI_API_KEY=

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Admin Defaults
SEED_DEMO_DATA=true
DEFAULT_ADMIN_EMAIL=admin@finwise.ai
DEFAULT_ADMIN_PASSWORD=Admin1234!
