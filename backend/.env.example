# FinWise AI - Backend Environment Configuration

# Environment mode: development, staging, production
# "development" prints one-time codes in the server console when no email provider is set.
# Leave as "production" on your live server (the default).
APP_ENV=development

# JWT Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL:
# For Local Development (Zero dependencies, SQLite):
DATABASE_URL=sqlite:///./finwise.db

# For Production with MySQL 8:
# DATABASE_URL=mysql+pymysql://finwise_user:finwise_secure_pass@db:3306/finwise_db

# Google Gemini API Key for Multi-Agent AI reasoning (Optional)
# If omitted or offline, the platform seamlessly uses deterministic rule-based calculators
GEMINI_API_KEY=

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (REQUIRED in production: sign-up and password-reset codes are emailed) ---
# Option A (recommended, HTTPS API, works on Render free tier): https://www.brevo.com
#   Create an API key, and verify the sender address you will use below.
BREVO_API_KEY=
# Option B: https://resend.com
RESEND_API_KEY=
# Option C: any SMTP server (e.g. Gmail with an App Password). Note: some hosts block SMTP ports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The "from" address (must be a verified sender for Brevo / Resend)
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FinWise AI Security

# Where the website lives (used for CORS) and any extra allowed origins, comma separated
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=

# Optional admin account. There is NO built-in default admin password; set your own private one.
DEFAULT_ADMIN_EMAIL=admin@finwise.ai
DEFAULT_ADMIN_PASSWORD=
